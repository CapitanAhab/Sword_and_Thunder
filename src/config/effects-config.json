{
  "version": 1,
  "masterVolume": 0.7,
  "synth": {
    "attackMs": 4,
    "release": "exponential"
  },
  "events": {
    "cursor": {
      "animation": {
        "preset": "snap",
        "durationMs": 220,
        "easing": "ease-out"
      },
      "sound": {
        "preset": "arc-glint",
        "notes": [
          {"wave": "sine", "freqFrom": 3136, "freqTo": 3136, "at": 0, "ms": 30, "gain": 0.08},
          {"wave": "sine", "freqFrom": 2093, "freqTo": 2093, "at": 0, "ms": 40, "gain": 0.1}
        ]
      },
      "vibrate": {
        "preset": "tick",
        "pattern": [6]
      }
    },
    "submenuEnter": {
      "animation": {
        "preset": "zoom",
        "durationMs": 200,
        "easing": "cubic-bezier(.2,.8,.2,1)"
      },
      "sound": {
        "preset": "chip-up",
        "notes": [
          {"wave": "square", "freqFrom": 523, "freqTo": 523, "at": 0, "ms": 45, "gain": 0.08},
          {"wave": "square", "freqFrom": 784, "freqTo": 784, "at": 50, "ms": 60, "gain": 0.08}
        ]
      },
      "vibrate": {
        "preset": "tick",
        "pattern": [6]
      }
    },
    "actionExecute": {
      "animation": {
        "preset": "slash",
        "durationMs": 320,
        "easing": "ease-in-out"
      },
      "sound": {
        "preset": "16-confirm",
        "notes": [
          {"wave": "sawtooth", "freqFrom": 523, "freqTo": 523, "at": 0, "ms": 70, "gain": 0.07, "filter": 2600},
          {"wave": "sawtooth", "freqFrom": 784, "freqTo": 784, "at": 60, "ms": 70, "gain": 0.07, "filter": 2600},
          {"wave": "sawtooth", "freqFrom": 1046, "freqTo": 1046, "at": 120, "ms": 160, "gain": 0.07, "filter": 2600, "vibrato": {"rate": 6, "depth": 20}, "echo": {"ms": 110, "feedback": 0.3, "mix": 0.3}}
        ]
      },
      "vibrate": {
        "preset": "double",
        "pattern": [15, 40, 25]
      }
    },
    "back": {
      "animation": {
        "preset": "drop",
        "durationMs": 200,
        "easing": "cubic-bezier(.2,.8,.2,1)"
      },
      "sound": {
        "preset": "chip-down",
        "notes": [
          {"wave": "square", "freqFrom": 784, "freqTo": 784, "at": 0, "ms": 40, "gain": 0.08},
          {"wave": "square", "freqFrom": 523, "freqTo": 523, "at": 45, "ms": 55, "gain": 0.08}
