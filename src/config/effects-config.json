          {"wave": "triangle", "freqFrom": 1568, "freqTo": 1568, "at": 0, "ms": 90, "gain": 0.16},
          {"wave": "triangle", "freqFrom": 2093, "freqTo": 2093, "at": 70, "ms": 90, "gain": 0.14},
