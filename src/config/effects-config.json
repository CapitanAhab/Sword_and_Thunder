      "vibrate": {
        "preset": "tick",
        "pattern": [6]
      }
    },
    "resourceSpend": {
      "animation": {
        "preset": "pop",
        "durationMs": 320,
        "easing": "ease-out"
      },
      "sound": {
        "preset": "16-crystal",
